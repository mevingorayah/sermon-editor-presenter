# syntax=docker/dockerfile:1
# Heavier DOCX/PDF export worker (docx + pdfkit) — more mem/CPU on Cloud Run.
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-bookworm-slim AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
# Pull Debian security fixes (e.g. perl-base CVEs fixed in 5.36.0-7+deb12u4).
RUN apt-get update \
  && apt-get install -y --no-install-recommends --only-upgrade perl-base \
  && apt-get upgrade -y --no-install-recommends \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV ROLE=export
ENV PORT=8080
ENV HOSTNAME=0.0.0.0
ENV SERMON_DATA_DIR=/app/data/sermons
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    fonts-liberation \
    fonts-noto-core \
    fontconfig \
  && rm -rf /var/lib/apt/lists/* \
  && fc-cache -f \
  && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg \
  && useradd --system --uid 1001 nextjs \
  && mkdir -p /app/data/sermons \
  && chown -R nextjs:nextjs /app/data
COPY --from=builder --chown=nextjs:nextjs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nextjs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nextjs /app/public ./public
# App's own OFL fonts (Literata, Inter, JetBrains Mono) for PDF/PNG, registered with fontconfig (mirrors shell image, bb7785a).
COPY --chown=root:root assets/fonts /app/assets/fonts
RUN printf '<?xml version="1.0"?>\n<!DOCTYPE fontconfig SYSTEM "fonts.dtd">\n<fontconfig><dir>/app/assets/fonts</dir></fontconfig>\n' > /etc/fonts/conf.d/50-app-fonts.conf \
  && fc-cache -f
# Writable per-user fontconfig cache for the non-root runtime user (system cache in /var/cache/fontconfig stays read-only).
ENV XDG_CACHE_HOME=/tmp/.cache
USER nextjs
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/api/export',{method:'OPTIONS'}).then(()=>process.exit(0)).catch(()=>fetch('http://127.0.0.1:8080/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1)))"
CMD ["node", "server.js"]
